<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <body class="has-sidebar {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Sidebar (left) -->
    {% include sidebar.liquid %}

    <!-- Main content (right) -->
    <main class="main-content" role="main">
      <div class="container">
        {% if page.toc and page.toc.sidebar %}
          {% if page.toc.sidebar == 'right' %}
            <div class="row">
              <div class="col-sm-9">{{ content }}</div>
              <div class="col-sm-3">
                <nav id="toc-sidebar" class="sticky-top"></nav>
              </div>
            </div>
          {% else %}
            <div class="row">
              <div class="col-sm-3">
                <nav id="toc-sidebar" class="sticky-top"></nav>
              </div>
              <div class="col-sm-9">{{ content }}</div>
            </div>
          {% endif %}
        {% else %}
          {{ content }}
        {% endif %}
      </div>

      {% include footer.liquid %}
    </main>

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
