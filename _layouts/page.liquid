---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% assign url_parts = page.url | split: '/' %}
  {% if url_parts[1] == 'supervision' and url_parts[2] != blank %}
    <a href="{{ '/supervision/' | relative_url }}" class="back-btn"><i class="fa-solid fa-arrow-left"></i> Back to Thesis & Internship Supervision</a>
  {% endif %}
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
